DMZ_COLLECTOR_GDS_EVENTS_TOKEN_FILE=
DMZ_COLLECTOR_OPCUA_DMZ_EVENTS_TOKEN=
DMZ_COLLECTOR_OPCUA_DMZ_EVENTS_TOKEN_FILE=

SPLUNK_HEC_ENABLED=false
